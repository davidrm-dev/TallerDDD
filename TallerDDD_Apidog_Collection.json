{
  "info": {
    "_postman_id": "taller-ddd-microservices",
    "name": "TallerDDD Microservices",
    "description": "API tests for Customer, Login, Order microservices with DDD and Kafka event-driven architecture",
    "schema": "https://schema.getpostman.com/json/d Collection/v2.1.0/"
