          "request": {"method": "GET", "url": {"raw": "http://localhost:8082/api/logins", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["api", "logins"]}, "header": [{"key": "Content-Type", "value": "application/json"}]}
        },
        {
          "name": "2. Get login by customer ID",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });", "pm.test('Has customerId', function() { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('customerId'); });"]}}],
          "request": {"method": "GET", "url": {"raw": "http://localhost:8082/api/logins/customer/44444", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["api", "logins", "customer", "44444"]}, "header": [{"key": "Content-Type", "value": "application/json"}]}
        }
