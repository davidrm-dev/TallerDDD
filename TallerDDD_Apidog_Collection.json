  "item": [
    {
      "name": "Customer Service (8081)",
      "item": [
        {
          "name": "1. List all customers",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });", "pm.test('Response is array', function() { var jsonData = pm.response.json(); pm.expect(jsonData).to.be.an('array'); });"]}}],
          "request": {"method": "GET", "url": {"raw": "http://localhost:8081/api/customers", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api", "customers"]}, "header": [{"key": "Content-Type", "value": "application/json"}]}
        },
        {
          "name": "2. Get customer by document",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });", "pm.test('Has document', function() { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('document'); });"]}}],
          "request": {"method": "GET", "url": {"raw": "http://localhost:8081/api/customers/44444", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api", "customers", "44444"]}, "header": [{"key": "Content-Type", "value": "application/json"}]}
        },
        {
          "name": "3. Create customer (triggers Kafka event)",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });", "pm.test('Customer created', function() { var jsonData = pm.response.json(); pm.expect(jsonData).to.have.property('document'); });"]}}],
          "request": {"method": "POST", "url": {"raw": "http://localhost:8081/api/customers", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api", "customers"]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"document\": \"77777\",\n  \"firstname\": \"Apidog\",\n  \"lastname\": \"Test\",\n  \"address\": \"123 Apidog St\",\n  \"phone\": \"555-7777\",\n  \"email\": \"apidog@test.com\",\n  \"username\": \"apidoguser\",\n  \"password\": \"pass777\"\n}"}}
        },
        {
          "name": "4. Update customer",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200', function() { pm.response.to.have.status(200); });"]}}],
          "request": {"method": "PUT", "url": {"raw": "http://localhost:8081/api/customers/77777", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api", "customers", "77777"]}, "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"firstname\": \"Updated\",\n  \"lastname\": \"User\",\n  \"address\": \"456 Updated Ave\",\n  \"phone\": \"555-0000\",\n  \"email\": \"updated@test.com\",\n  \"username\": \"updateduser\",\n  \"password\": \"newpass\"\n}"}}
        },
        {
          "name": "5. Delete customer",
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 204', function() { pm.response.to.have.status(204); });"]}}],
          "request": {"method": "DELETE", "url": {"raw": "http://localhost:8081/api/customers/77777", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api", "customers", "77777"]}, "header": []}
        }
      ]
    },
